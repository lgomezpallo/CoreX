# PostgreSQL: use the Supabase session-pooler connection string for the app.
# Keep this as a secret in Replit/Cloud Run; do not commit a populated .env.
SUPABASE_DATABASE_URL=

# Keep the same value used to encrypt existing provider credentials when
# moving existing database rows.
SESSION_SECRET=

# Clerk external instance credentials. VITE_CLERK_PUBLISHABLE_KEY is injected
# at frontend build time; the two server-side variables are runtime settings.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PROXY_URL=
CLERK_PROXY_ENABLED=false

PORT=8080
NODE_ENV=production
BASE_PATH=/
STATIC_DIR=./public