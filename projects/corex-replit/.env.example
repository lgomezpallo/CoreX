# Direct AI connection used by CoreX. Server-only; never prefix with VITE_.
GROQ_API_KEY=
# Optional model override. CoreX has a working default if omitted.
GROQ_MODEL=qwen/qwen3.8-27b

# Public Supabase client configuration used by the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLIC_KEY=

# Optional API server settings.
PORT=8080
LOG_LEVEL=info
