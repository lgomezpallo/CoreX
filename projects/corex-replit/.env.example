# Root URL for the Router IA API. Override only for a compatible deployment.
ROUTER_URL=https://router-ia.luisgomezpallo.workers.dev

# Server-only credentials. Never prefix these with VITE_.
ROUTER_APP_KEY=
# Optional; the Router IA request field/header must be confirmed before it is sent.
ROUTER_APP_ID=

# Public Supabase client configuration used by the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLIC_KEY=

# Optional API server settings.
PORT=8080
LOG_LEVEL=info