# Router IA server URL. Override it for a local or alternate deployment.
ROUTER_URL=https://router-ia.luisgomezpallo.workers.dev

# Server-only App Key issued by Router IA. Never prefix with VITE_.
ROUTER_APP_KEY=

# Public Supabase client configuration used by the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLIC_KEY=

# Optional API server settings.
PORT=8080
LOG_LEVEL=info
